# URL à pinguer périodiquement (obligatoire)
TARGET_URL=https://votre-service.example.com/health

# Intervalle entre deux pings, en minutes (défaut: 10)
INTERVAL_MINUTES=10

# Timeout d'une requête, en secondes (défaut: 20)
REQUEST_TIMEOUT_S=20

# Port du petit serveur de statut local (défaut: 3000)
PORT=3000
